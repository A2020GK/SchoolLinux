# Frontend preview mode (Vite)
# Copy values into your local .env file when you need quick screen previews.

# Optional backend override. By default app uses http://<hostname>:8000
VITE_API_BASE_URL=http://localhost:8000

# Enables local mock data in frontend contexts, no backend required
VITE_MOCK_PREVIEW=true

# Available: student-login | student-content | teacher
VITE_MOCK_SCREEN=student-content

# Optional values for student preview mode
VITE_MOCK_STUDENT_NAME=Тест Тестовский
VITE_MOCK_STUDENT_PC=403-1
VITE_MOCK_STUDENT_SCORE=12
